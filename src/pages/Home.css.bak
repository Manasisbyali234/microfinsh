.about-teaser-inner {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 3.5rem;
  align-items: center;
}
.about-teaser-img-col { position: relative; padding-bottom: 1.5rem; padding-right: 1.5rem; }
.about-teaser-img {
  width: 100%;
  height: 380px;
  object-fit: cover;
  border-radius: 20px;
  border: 1.5px solid var(--color-line);
  display: block;
}
.about-teaser-img-badge {
  position: absolute;
  bottom: -1.25rem;
  right: -1.25rem;
  background: var(--color-accent-deep);
  color: #fff;
  padding: 1rem 1.25rem;
  border-radius: 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4px 20px rgba(28,110,164,0.3);
}
.badge-num {
  font-family: var(--font-display);
  font-size: 1.8rem;
  font-weight: 700;
  line-height: 1;
}
.badge-txt {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0.85;
  margin-top: 0.2rem;
}
.about-teaser-body p { color: var(--color-ink-soft); line-height: 1.75; }

.section-alt { background: var(--color-white); }

.card-grid-4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.25rem;
  margin-top: 2rem;
}

/* Carousel */
.carousel-track-wrap {
  overflow: hidden;
  margin-top: 2rem;
}
@keyframes carousel-scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
.carousel-track {
  display: flex;
  gap: 1.25rem;
  width: max-content;
  animation: carousel-scroll 10s linear infinite;
}
.carousel-track:hover { animation-play-state: paused; }
.carousel-item {
  flex: 0 0 280px;
  height: 340px;
}

/* Industries carousel */
.ind-carousel-wrap {
  position: relative;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-top: 2rem;
}
.ind-carousel-viewport {
  flex: 1;
  overflow: hidden;
}
.ind-carousel-track {
  display: flex;
  gap: 1.25rem;
  transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
}
.ind-carousel-item {
  flex: 0 0 calc((100% - 2 * 1.25rem) / 3);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.85rem;
  padding: 1.75rem 1rem;
  border: 1.5px solid var(--color-line);
  border-radius: 16px;
  background: rgba(255,255,255,0.04);
  transition: background 0.2s, border-color 0.2s, transform 0.2s;
}
.ind-carousel-item:hover {
  background: rgba(79,168,216,0.08);
  border-color: rgba(79,168,216,0.45);
  transform: translateY(-3px);
}
.ind-carousel-btn {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1.5px solid var(--color-line);
  background: rgba(255,255,255,0.06);
  color: var(--color-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.2s, border-color 0.2s;
}
.ind-carousel-btn:hover { background: rgba(79,168,216,0.15); border-color: #4FA8D8; }
.ind-carousel-btn svg { width: 18px; height: 18px; }
.ind-carousel-dots {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
  margin-top: 1.25rem;
}
.ind-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: none;
  background: rgba(79,168,216,0.3);
  cursor: pointer;
  transition: background 0.2s, transform 0.2s;
  padding: 0;
}
.ind-dot.active { background: #4FA8D8; transform: scale(1.35); }

.industry-logo-icon {
  width: 56px;
  height: 56px;
  flex-shrink: 0;
}
.industry-logo-icon svg { width: 100%; height: 100%; }
.industry-logo-name {
  font-family: var(--font-display);
  font-size: 0.82rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-ink);
  text-align: center;
  line-height: 1.3;
}

/* Certifications */
.cert-section {
  position: relative;
  padding: 1.75rem 1.5rem;
  overflow: hidden;
}
.cert-section-bg-wrap { position: absolute; inset: 0; }
.cert-section-bg { width: 100%; height: 100%; object-fit: cover; }
.cert-section-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(12,24,31,0.92) 0%, rgba(28,110,164,0.75) 100%);
}
.cert-section-inner { position: relative; z-index: 1; }
.cert-row { display: flex; gap: 1.25rem; flex-wrap: wrap; }
.cert-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1.5px solid rgba(184,212,232,0.3);
  border-radius: 16px;
  padding: 1.25rem 2rem;
  background: rgba(255,255,255,0.07);
  backdrop-filter: blur(4px);
  min-width: 150px;
  transition: background 0.2s, border-color 0.2s;
}
.cert-badge:hover { background: rgba(255,255,255,0.13); border-color: rgba(184,212,232,0.6); }
.cert-label {
  font-family: var(--font-mono);
  font-size: 1.15rem;
  font-weight: 600;
  color: #4FA8D8;
  letter-spacing: 0.06em;
}
.cert-sub {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(184,212,232,0.7);
  margin-top: 0.3rem;
}

/* CTA banner */
.cta-banner { position: relative; padding: 1.75rem 1.5rem; overflow: hidden; }
.cta-banner-bg-wrap { position: absolute; inset: 0; }
.cta-banner-bg { width: 100%; height: 100%; object-fit: cover; }
.cta-banner-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to right, rgba(12,24,31,0.88) 40%, rgba(12,24,31,0.6));
}
.cta-banner-inner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  flex-wrap: wrap;
}
.cta-banner-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; }
.cta-btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #fff;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.9rem;
  padding: 0.8rem 1.5rem;
  border-radius: 50px;
  border: 2px solid rgba(255,255,255,0.5);
  cursor: pointer;
  transition: background 0.2s, border-color 0.2s;
  min-height: 44px;
}
.cta-btn-outline:hover { background: rgba(255,255,255,0.1); border-color: #fff; }

/* â”€â”€ Responsive â”€â”€ */
@media (max-width: 1100px) {
  .card-grid-4 { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .about-teaser-inner { grid-template-columns: 1fr; gap: 2rem; }
  .about-teaser-img { height: 220px; border-radius: 16px; }
  .about-teaser-img-badge { bottom: -0.75rem; right: 0.75rem; border-radius: 12px; }
  .ind-carousel-item { flex: 0 0 calc((100% - 1.25rem) / 2); }
  .cert-section { padding: 1rem 1rem; }
  .cert-row { justify-content: center; gap: 0.75rem; }
  .cert-badge { min-width: 120px; padding: 1rem; border-radius: 12px; }
  .cta-banner { padding: 1rem 1rem; }
  .cta-banner-inner { flex-direction: column; align-items: stretch; }
  .cta-banner-actions { flex-direction: column; }
  .cta-btn-outline, .cta-banner-actions .btn-primary { width: 100%; }
}
@media (max-width: 480px) {
  .ind-carousel-item { flex: 0 0 100%; }
  .card-grid-4 > * { flex: 0 0 80vw; }
}

/* Founder strip in home about teaser */
.home-founder-strip {
  margin-top: 1.25rem;
  padding: 1rem 1.25rem;
  border-left: 3px solid var(--color-accent-deep);
  background: rgba(28,110,164,0.05);
  border-radius: 0 var(--radius) var(--radius) 0;
}
.home-founder-tag {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-accent-deep);
  font-weight: 600;
  margin-bottom: 0.5rem;
}
.home-founder-strip p {
  margin: 0;
  font-size: 0.92rem;
  color: var(--color-ink-soft);
  line-height: 1.7;
}

/* Vision / Mission / Why Choose Us */
.vision-section { background: var(--color-white); }
.vision-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  margin-top: 2rem;
}
.vision-card {
  padding: 2rem;
  border: 1.5px solid var(--color-line);
  border-radius: 16px;
  background: var(--color-surface, #f8fafc);
  transition: box-shadow 0.2s, border-color 0.2s;
}
.vision-card:hover { box-shadow: 0 6px 24px rgba(28,110,164,0.1); border-color: #4FA8D8; }
.vision-card-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: rgba(79,168,216,0.12);
  color: #1C6EA4;
  margin-bottom: 1rem;
}
.vision-card-icon svg { width: 24px; height: 24px; }
.vision-card h3 {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--color-ink);
  margin: 0 0 0.6rem;
}
.vision-card p { color: var(--color-ink-soft); line-height: 1.75; margin: 0; font-size: 0.95rem; }

.why-us-wrap {
  margin-top: 2.5rem;
  padding: 2rem;
  border: 1.5px solid var(--color-line);
  border-radius: 16px;
  background: var(--color-surface, #f8fafc);
}
.why-us-title {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--color-ink);
  margin: 0 0 1.25rem;
}
.why-us-grid { display: flex; flex-direction: column; gap: 1rem; }
.why-us-item { display: flex; gap: 1rem; align-items: flex-start; }
.why-us-emoji { font-size: 1.4rem; flex-shrink: 0; margin-top: 0.1rem; }
.why-us-item strong { display: block; font-weight: 700; color: var(--color-ink); margin-bottom: 0.2rem; font-size: 0.95rem; }
.why-us-item p { margin: 0; color: var(--color-ink-soft); font-size: 0.9rem; line-height: 1.65; }

.vision-looking-ahead {
  margin-top: 2rem;
  padding: 1.25rem 1.5rem;
  border-left: 3px solid #4FA8D8;
  background: rgba(79,168,216,0.06);
  border-radius: 0 12px 12px 0;
  color: var(--color-ink-soft);
  font-size: 0.95rem;
  line-height: 1.75;
}

@media (max-width: 768px) {
  .vision-grid { grid-template-columns: 1fr; }
  .why-us-wrap { padding: 1.25rem; }
}

